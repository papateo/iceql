{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IceQL",
  "version": "0.1.7",
  "identifier": "com.iceql.sqlclient",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "IceQL — The cool way to manage your database",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "./entitlements.plist",
      "signingIdentity": "Apple Distribution: Anonymous Developer (TEAMID-REDACTED)"
    }
  },
  "plugins": {}
}
